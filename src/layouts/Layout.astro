---
import "../css/style.css";
import UserMenu from "../components/UserMenu.svelte";
import Header  from "../components/Header.svelte";

let { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- <link rel="stylesheet" href="/css/style.css" /> -->
    <script src="../js/main.ts"></script>
  </head>
  <body>
    
    <Header client:load />
    <slot />
    <footer>&copy;NOT a real business</footer>

    <script>
      import { updateCartCount } from "../js/cartCount";

      // display the saved cart count when the page loads.
      updateCartCount();

      // update the badge immediately when a product is added.
      window.addEventListener("cart-updated", updateCartCount);

      // update the badge if the cart changes in another browser tab.
      window.addEventListener("storage", (event) => {
        if (event.key === "so-cart") {
          updateCartCount();
        }
      });
    </script>
  </body>
</html>
