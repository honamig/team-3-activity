---
import '../css/home.css';
// import { getProducts } from '../js/productData.mts';

import Layout from '../layouts/Layout.astro';
const title = "Homepage"

// console.log(getProducts())

---

<Layout title={title}>
	<main class="divider">
      <div class="hero">
        <img
          src="/images/banner-sm.jpg"
          srcset="images/banner-sm.jpg 500w, images/banner.jpg"
          alt="image of a high mountain lake"
        />
        <div class="logo logo--square">
          <img src="/images/noun_Tent_2517.svg" alt="tent image for logo" />
          <div>Sleep<span class="highlight">Outside</span></div>
        </div>
      </div>
      <section class="mission">
        <p>We spend too much time these days indoors...sitting usually.</p>
        <p>No wonder we are a mess!</p>
        <p>
          What we really need is to get outside...in fact SLEEP outside. Our
          mission is to provide you with everything you need to do this
          comfortably at an affordable price.
        </p>
      </section>
      <section class="category-grid">
        <div class="category-card">
          <a href="/product-list/index.html?category=tents">
            <img src="https://wdd360.netlify.app/images/category-icons/noun_Tent_3544767.svg" alt=“Tent icon from Noun Project: Mustofa Bayu”/>
            <p>Tents</p>
          </a>
        </div>
        <div class="category-card">
          <a href="/product-list/index.html?category=sleeping-bags">
            <img src="https://wdd360.netlify.app/images/category-icons/noun_Sleeping_Bag_3544775.svg" alt=“Sleeping Bag Icon from Noun Project: Mustofa Bayu”/>
            <p>Sleeping Bags</p>
          </a>
        </div>
        <div class="category-card">
          <a href="/product-list/index.html?category=backpacks">
            <img src="https://wdd360.netlify.app/images/category-icons/noun_carrier_bag_3544771.svg" alt=“Backpack Icon from Noun Project: Mustofa Bayu”/>
            <p>Backpacks</p>
          </a>
        </div>
        <div class="category-card">
          <a href="/product-list/index.html?category=hammocks">
            <img src="https://wdd360.netlify.app/images/category-icons/noun_Hammock_791143.svg" alt=“Hammock Icon from Noun Project: Paul Richard”/>
            <p>Hammocks</p>
          </a>
        </div>
      </section>
      
    </main>
	<script src="../js/main.ts"></script>
</Layout>
